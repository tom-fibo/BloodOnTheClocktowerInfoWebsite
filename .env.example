# Metered.ca TURN REST API credentials (https://www.metered.ca) — sign up for a
# free account, create a TURN app, and copy these two values from your dashboard.
# Required for reliable P2P connections on restrictive networks (public/guest
# Wi-Fi, symmetric NAT, corporate firewalls); without them the app falls back to
# STUN-only, which works on most home networks but not all. See MAINTENANCE.md.
VITE_METERED_APP_NAME=
VITE_METERED_API_KEY=
